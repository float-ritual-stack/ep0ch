#!/usr/bin/env bun
// The door's `wl-copy` (PIE-797), on PATH in the drawer agent's Herdr pane (src/desk/herdr-agent.ts, clipVars). Claude
// Code copies with wl-copy when it sees WAYLAND_DISPLAY, else with OSC 52, and Herdr doesn't pass a pane's OSC 52 on to
// a `herdr terminal attach` client like the door's tile (herdrdev/herdr#4612). So the copy goes two ways: as OSC 52 on
// the pane's own terminal (Herdr gives it to its foreground client, as before) and to the door showing the pane
// (`terminal.clip`, over the pane's EP0CH_CONTROL), which puts it on the person's clipboard if they use that tile.
// `--primary` (the selection clipboard Claude also fills) is left alone. Never fails the copy: it always exits 0.
// Remove once herdrdev/herdr#4612 ships, with clipVars in src/desk/herdr-agent.ts.
import { openSync, writeSync, closeSync } from "node:fs";
import { ask } from "../../src/jsonl";
import { COPY_MAX as CAP } from "../../src/surface/selection";

const args = process.argv.slice(2);
// wl-copy's own forms: text as arguments (`wl-copy hello`), else on stdin; options with a value skipped.
const WITH_VALUE = new Set(["-t", "--type", "-s", "--seat"]);
const words: string[] = [];
let primary = false, clear = false;
for (let i = 0; i < args.length; i++) {
  const a = args[i]!;
  if (a === "--") { words.push(...args.slice(i + 1)); break; }
  if (WITH_VALUE.has(a)) { i += 1; continue; }
  if (a === "-p" || a === "--primary") primary = true;
  else if (a === "-c" || a === "--clear") clear = true;
  else if (!a.startsWith("-")) words.push(a);
}
// Stdin is read to its end even when it's dropped, so whoever writes to it is never cut off; past the door's cap it is
// read and let go (the door says it was too big), never held.
async function stdin(keep: boolean): Promise<string> {
  const parts: Uint8Array[] = [];
  let size = 0;
  for await (const chunk of Bun.stdin.stream()) {
    size += chunk.length;
    if (keep && size <= CAP) parts.push(chunk);
  }
  return size > CAP ? "x".repeat(CAP + 1) : Buffer.concat(parts).toString("utf8");
}
const text = words.length ? words.join(" ") : await stdin(!(primary || clear));
if (primary || clear) process.exit(0);
if (text) {
  // One over the cap goes only to the door, as a placeholder of its size, so the toast says it was too big.
  if (Buffer.byteLength(text) <= CAP) try {
    const tty = openSync("/dev/tty", "w");
    writeSync(tty, `\x1b]52;c;${Buffer.from(text).toString("base64")}\x07`);
    closeSync(tty);
  } catch { /* no terminal: the door's way is enough */ }
  const control = process.env.EP0CH_CONTROL, tile = process.env.EP0CH_TILE_ID || process.env.EP0CH_TILE;
  if (control && tile) await ask(control, { cmd: "act", action: "terminal.clip", args: { text }, tile }, 1500).catch(() => null);
}
process.exit(0);
