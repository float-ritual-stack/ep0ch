#!/usr/bin/env bash
# with-secrets v1
# with-secrets: run one command with only the secrets it needs.
#
#   with-secrets typesafe -- uv run label.py
#   with-secrets typesafe,openrouter -- bun server.ts
#   with-secrets --list              groups and the variable names in each (never values)
#   with-secrets --add <group> <VAR> prompt for a value (not echoed) and write it to the group
#
# A group is ~/.config/secrets/<group>.env (KEY=value lines, mode 600, folder 700).
# On macOS, a group with no file falls back to the Keychain: each line of
# ~/.config/secrets/<group>.keys names a variable, read from the generic password
# with service "with-secrets:<group>:<VAR>" (add one with:
#   security add-generic-password -a "$USER" -s "with-secrets:<group>:<VAR>" -w).
# Secrets reach only the command you run; nothing is exported to your shell.
set -euo pipefail
dir="${WITH_SECRETS_DIR:-$HOME/.config/secrets}"

if [[ "${1:-}" == "--add" ]]; then
  # with-secrets --add <group> <VAR>: prompts for the value without echoing it, then writes or replaces VAR in the
  # group's file (mode 600, folder 700). The value is never printed.
  [[ $# -eq 3 ]] || { echo "usage: with-secrets --add <group> <VAR>" >&2; exit 2; }
  g="$2"; v="$3"
  [[ "$g" =~ ^[a-z0-9._-]+$ ]] || { echo "with-secrets: bad group name: $g" >&2; exit 2; }
  [[ "$v" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "with-secrets: bad variable name: $v" >&2; exit 2; }
  install -d -m 700 "$dir"
  read -rsp "$v for $g: " val </dev/tty; echo >&2
  [[ -n "$val" ]] || { echo "with-secrets: nothing entered; nothing written" >&2; exit 1; }
  f="$dir/$g.env"; tmp=$(umask 077; mktemp "$dir/.$g.XXXXXX")
  { [[ -f "$f" ]] && grep -v -E "^$v=" "$f" || true; printf '%s=%s\n' "$v" "$val"; } > "$tmp"
  chmod 600 "$tmp"; mv "$tmp" "$f"
  echo "with-secrets: $v set in $g ($f)" >&2
  exit 0
fi

if [[ "${1:-}" == "--list" ]]; then
  shopt -s nullglob
  for f in "$dir"/*.env "$dir"/*.keys; do
    g=$(basename "$f"); g=${g%.*}
    names=$(grep -oE '^[A-Za-z_][A-Za-z0-9_]*' "$f" | tr '\n' ' ')
    printf '%-14s %s(%s)\n' "$g" "$names" "${f##*.}"
  done
  exit 0
fi

if [[ $# -lt 3 || "$2" != "--" ]]; then
  echo "usage: with-secrets <group>[,<group>...] -- <command> [args...]   (with-secrets --list | --add <group> <VAR>)" >&2
  exit 2
fi
groups="$1"; shift 2

IFS=',' read -ra gs <<<"$groups"
for g in "${gs[@]}"; do
  [[ "$g" =~ ^[a-z0-9._-]+$ ]] || { echo "with-secrets: bad group name: $g" >&2; exit 2; }
  f="$dir/$g.env"
  if [[ -f "$f" ]]; then
    perm=$(stat -c '%a' "$f" 2>/dev/null || stat -f '%Lp' "$f")
    [[ "$perm" == "600" || "$perm" == "400" ]] || { echo "with-secrets: $f is mode $perm; run: chmod 600 $f" >&2; exit 1; }
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
      key=${line%%=*}; val=${line#*=}
      val=${val%\"}; val=${val#\"}; val=${val%\'}; val=${val#\'}
      export "$key=$val"
    done <"$f"
  elif [[ "$(uname)" == "Darwin" && -f "$dir/$g.keys" ]]; then
    while IFS= read -r key || [[ -n "$key" ]]; do
      [[ -z "$key" || "$key" == \#* ]] && continue
      val=$(security find-generic-password -s "with-secrets:$g:$key" -w 2>/dev/null) \
        || { echo "with-secrets: no Keychain item with-secrets:$g:$key" >&2; exit 1; }
      export "$key=$val"
    done <"$dir/$g.keys"
  else
    echo "with-secrets: no secrets for '$g' (expected $f)" >&2; exit 1
  fi
done
exec "$@"
