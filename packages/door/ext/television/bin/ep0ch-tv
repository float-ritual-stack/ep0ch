#!/bin/sh
# ep0ch-tv: television's side of the outline (packages/door/ext/television). The cable files call it; each subcommand
# is one line of work on the door's CLI (`ep0ch find`, `ep0ch show`, `ep0ch open`, `ep0ch outline list`), from the
# checkout this script is in, so the channels and the door are always the same code.
#
#   ep0ch-tv notes                     every note: id, title, path, and what tv shows
#   ep0ch-tv preview <id>              the note as the door draws it, as wide as tv's preview panel
#   ep0ch-tv open <id>                 open it in the running door (EP0CH_CONTROL, else the person's), as the agent `television`
#   ep0ch-tv detail <id>               show it in the Outliner's Tree and its linked Detail (outliner goto)
#   ep0ch-tv files                     files under this folder: absolute path, then as shown
#   ep0ch-tv file-preview <path>       a file's start
#   ep0ch-tv outlines                  this machine's outlines and the machines opened before: name, machine, as shown
#   ep0ch-tv outline-preview <name> <machine>   an outline's newest notes
#   ep0ch-tv launch <name> <machine>   the door on that outline (exec)
#
# Which outline: the door's rule (--ws, EP0CH_WS, EP0CH_SOCKET, the folder's .ep0ch). Run from the door's ctrl+t, the
# door names its own outline (EP0CH_SOCKET and EP0CH_WS).
set -eu
here=$(dirname "$(readlink -f "$0")")
door=${EP0CH_DOOR_MAIN:-$(readlink -f "$here/../../../src/main.ts")}
ep0ch() { bun "$door" "$@"; }
tab=$(printf '\t')
# tv's preview panel, in columns: its share of the terminal (the cable files ask for 60%) less its border.
panel() {
  cols=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2) || cols=""
  [ -n "$cols" ] || cols=${COLUMNS:-120}
  w=$((cols * ${EP0CH_TV_PREVIEW:-60} / 100 - 6))
  [ "$w" -ge 20 ] || w=20
  echo "$w"
}
cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
  notes)
    ep0ch find --lines | awk -F'\t' -v OFS='\t' '{ print $1, $2, $3, ($3 == "" ? $2 : $2 "  · " $3) }' ;;
  preview)
    ep0ch show "$1" --ansi --width "$(panel)" ;;
  open)
    if out=$(ep0ch open "$1" --as television 2>&1); then printf 'opened in the door\n' >&2
    else printf 'ep0ch-tv: %s\n' "$out" >&2; sleep 2; fi ;;
  detail)
    outliner="$(dirname "$door")/../../outliner/src/cli.ts"
    if out=$(bun "$outliner" goto "$1" 2>&1); then printf 'shown in the Outliner\n' >&2
    else
      why=$(printf '%s\n' "$out" | sed -n 's/^error: //p' | head -n 1)
      printf 'ep0ch-tv: the Outliner says: %s\n  (it shows a note in a running Tree and its Detail: open them first, Herdr'"'"'s Outliner: open)\n' "${why:-$out}" >&2; sleep 3
    fi ;;
  files)
    if command -v fd >/dev/null 2>&1; then fd --type f --hidden --exclude .git --absolute-path
    else find "$PWD" -type f -not -path '*/.git/*'; fi | awk -v cwd="$PWD/" -v OFS='\t' '{ r = $0; if (index(r, cwd) == 1) r = substr(r, length(cwd) + 1); print $0, r }' ;;
  file-preview)
    if command -v bat >/dev/null 2>&1; then bat --color=always --style=numbers --line-range=:200 "$1"
    else head -n 200 "$1"; fi ;;
  outlines)
    ep0ch outline list --all --lines | awk -F'\t' -v OFS='\t' '{ where = ($2 == "" ? "this machine" : "on " $2); print $1, $2, ($1 == "" ? "· " where "  (" $3 ")" : $1 "  · " where) }' ;;
  outline-preview)
    if [ -z "$1" ]; then printf '%s is %s.\nEnter opens the door there: it connects, then asks which outline.\n' "${2:-the machine}" "not connected"; exit 0; fi
    name=$1 machine=${2:-}
    set -- --ws "$name"
    [ -n "$machine" ] && set -- "$@" --machine "$machine"
    printf 'newest notes in %s%s\n\n' "$name" "${machine:+ on $machine}"
    ep0ch find --lines "$@" | head -n 60 | cut -f2 ;;
  launch)
    name=$1 machine=${2:-}
    set --
    [ -n "$name" ] && set -- --ws "$name"
    [ -n "$machine" ] && set -- "$@" --machine "$machine"
    exec "$door" "$@" ;;
  *)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
