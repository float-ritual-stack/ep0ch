{
  "contract": 2,
  "id": "screens",
  "version": 1,
  "name": "Screens",
  "description": "The screens and tile kinds every door ships: the desk, the navigator, the board, last callers, who's online, the keys and the library, and the outline, reader, query, links, comments, proposals, revisions and activity tiles they are made of. Fork it to change what a door opens on.",
  "defaultOn": true,
  "tiles": [
    {
      "kind": "tree",
      "name": "Outline",
      "description": "the outline tree; ⏎ opens a note where its opens land",
      "drawer": "list",
      "fields": {
        "from": "children"
      },
      "replaces": [
        "tree"
      ]
    },
    {
      "kind": "reader",
      "name": "Reader",
      "description": "a reader of notes (a detail): it keeps the note opened into it (note=<id> to start on one); mode=pinned pins it, on that note or page=<name>, so every open aimed at it lands beside it",
      "drawer": "page",
      "replaces": [
        "reader"
      ]
    },
    {
      "kind": "query",
      "name": "Query",
      "description": "the cards a saved view lists (view=<the virtual branch's block id>), or a query in the views' grammar (query=\"type=bed\", source=tile:<its home reader>: a tag opened in a reader, PIE-800); a board lane is one",
      "drawer": "list",
      "fields": {
        "from": "query"
      },
      "replaces": [
        "query"
      ]
    },
    {
      "kind": "backlinks",
      "name": "Links",
      "description": "the links of a note, its subject, beside its home reader (source=tile:<name>): its outlinks, resources, backlinks and children (linkGroups= names some); subject=held (the default) keeps the subject until b aims it again, subject=follows lists what its home shows as it changes; stages=next,doing,waiting names the stage values its headers and Stage control use, in that order (others are said as other, never hidden)",
      "drawer": "list",
      "fields": {
        "from": "links"
      },
      "replaces": [
        "backlinks"
      ]
    },
    {
      "kind": "props",
      "name": "Properties",
      "description": "the properties and the record of the note another tile shows (source=tile:<name>); a pick opens the question for that value",
      "drawer": "list",
      "fields": {
        "from": "properties",
        "subject": "follows"
      },
      "replaces": [
        "props"
      ]
    },
    {
      "kind": "facets",
      "name": "Facets",
      "description": "the properties the notes have, each opening to its values with uses and last use: include or exclude values (ORed in a facet, ANDed across them), path values as a tree, the selection as the views' query text, editable and savable as a view (PIE-881); query=<a starting query>; ^W o # opens it on the tags facet (args.open=[tag], no calendar)",
      "drawer": "list",
      "fields": {
        "from": "facets"
      },
      "replaces": [
        "facets"
      ]
    },
    {
      "kind": "matches",
      "name": "Matches",
      "description": "a facets tile's Matches (PIE-1443: the notes its selection leaves, grouped Pinned, Today, Yesterday, Previous 7 days, then months) in a tile of its own beside it (source=tile:<the facets tile>); its select and open wires say where a pick previews and ⏎ opens. Opened by facets.place place=tile (ctrl+o), closed when Matches goes back",
      "drawer": "list",
      "fields": {
        "from": "query",
        "sort": "updated desc"
      },
      "replaces": [
        "matches"
      ]
    },
    {
      "kind": "activity",
      "name": "Activity",
      "description": "recent edits by people and agents",
      "drawer": "list",
      "fields": {
        "from": "activity"
      },
      "replaces": [
        "activity"
      ]
    },
    {
      "kind": "who",
      "name": "Who",
      "description": "who's attached to the outline",
      "drawer": "list",
      "fields": {
        "from": "clients"
      },
      "replaces": [
        "who"
      ]
    },
    {
      "kind": "threads",
      "name": "Comments",
      "description": "the comment threads on the note another tile shows (source=tile:<name>): the ones open first, each with its passage and replies under it, and Reply and Resolve as its own presses",
      "drawer": "list",
      "fields": {
        "from": "threads",
        "subject": "follows"
      },
      "replaces": [
        "threads"
      ]
    },
    {
      "kind": "proposals",
      "name": "Proposals",
      "description": "the edits waiting beside the note another tile shows (source=tile:<name>): who sent each and why it didn't apply, what it would change as lines, and Apply and Dismiss as its own presses",
      "drawer": "list",
      "fields": {
        "from": "proposals",
        "subject": "follows"
      },
      "replaces": [
        "proposals"
      ]
    },
    {
      "kind": "revisions",
      "name": "Revisions",
      "description": "the texts the note another tile shows had (source=tile:<name>), newest first; a press on an earlier one shows what changed since, and Restore puts its text in the editor",
      "drawer": "list",
      "fields": {
        "from": "revisions",
        "subject": "follows"
      },
      "replaces": [
        "revisions"
      ]
    },
    {
      "kind": "keymap",
      "name": "Keys",
      "description": "every way to press an action in this door: its keys, the act line they run, where they hold and what they do, read from the actions' own rows; a pick runs the line",
      "drawer": "list",
      "fields": {
        "from": "actions"
      },
      "replaces": [
        "keymap"
      ]
    },
    {
      "kind": "components",
      "name": "Components",
      "description": "every component there is to write, under its group; a press on one shows what it is, its own example as written and that example drawn",
      "drawer": "list",
      "fields": {
        "from": "components"
      },
      "replaces": [
        "components"
      ]
    }
  ],
  "screens": [
    {
      "name": "desk",
      "title": "Desk",
      "start": true,
      "lands": "reader",
      "newNote": [
        {
          "opens": "lands"
        }
      ],
      "toolbar": [
        "back",
        "bar.open",
        "bar.open scope=query",
        "bar.open scope=screens",
        "note.new",
        "tile.split",
        "screen.save",
        "screen.reset",
        "dock.toggle side=right"
      ],
      "layout": {
        "focus": "reader",
        "root": {
          "t": "split",
          "dir": "row",
          "weights": [
            0.22,
            0.78
          ],
          "kids": [
            {
              "t": "leaf",
              "kind": "tree",
              "name": "tree",
              "wires": [
                {
                  "verb": "select",
                  "to": "reader"
                }
              ]
            },
            {
              "t": "split",
              "dir": "row",
              "weights": [
                0.72,
                0.28
              ],
              "kids": [
                {
                  "t": "leaf",
                  "kind": "reader",
                  "name": "reader"
                },
                {
                  "t": "dock",
                  "edge": "right",
                  "open": true,
                  "policy": {
                    "overlay": false
                  },
                  "kid": {
                    "t": "split",
                    "dir": "col",
                    "weights": [
                      0.3,
                      0.3,
                      0.4
                    ],
                    "kids": [
                      {
                        "t": "leaf",
                        "kind": "props",
                        "name": "props",
                        "source": "tile:reader",
                        "subject": "follows"
                      },
                      {
                        "t": "leaf",
                        "kind": "backlinks",
                        "name": "backlinks",
                        "source": "tile:reader",
                        "subject": "follows"
                      },
                      {
                        "t": "tabs",
                        "active": 0,
                        "tabs": [
                          {
                            "t": "leaf",
                            "kind": "threads",
                            "name": "threads",
                            "source": "tile:reader"
                          },
                          {
                            "t": "leaf",
                            "kind": "proposals",
                            "name": "proposals",
                            "source": "tile:reader"
                          },
                          {
                            "t": "leaf",
                            "kind": "revisions",
                            "name": "revisions",
                            "source": "tile:reader"
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "navigator",
      "title": "navigator",
      "lands": "reader",
      "target": {
        "arg": "query",
        "fills": "facets.query"
      },
      "toolbar": [
        "back",
        "bar.open",
        "bar.open scope=screens",
        "screen.reset"
      ],
      "layout": {
        "focus": "facets",
        "root": {
          "t": "flow",
          "key": "navigator",
          "anchor": 1,
          "held": [
            0,
            1,
            2
          ],
          "kids": [
            {
              "t": "leaf",
              "kind": "facets",
              "name": "facets",
              "args": {
                "place": "tile",
                "open": [
                  "views"
                ]
              }
            },
            {
              "t": "leaf",
              "kind": "matches",
              "name": "matches",
              "source": "tile:facets",
              "wires": [
                {
                  "verb": "select",
                  "to": "reader"
                },
                {
                  "verb": "open",
                  "to": "reader"
                }
              ]
            },
            {
              "t": "leaf",
              "kind": "reader",
              "name": "reader"
            }
          ]
        }
      }
    },
    {
      "name": "board",
      "title": "board",
      "lands": "reader",
      "toolbar": [
        "back",
        "bar.open",
        "bar.open scope=screens",
        "note.new",
        "screen.reset"
      ],
      "layout": {
        "focus": "lanes",
        "root": {
          "t": "split",
          "dir": "col",
          "weights": [
            0.58,
            0.42
          ],
          "kids": [
            {
              "t": "leaf",
              "kind": "query",
              "name": "lanes",
              "query": "work-stage",
              "group": "work-stage",
              "sort": "updated desc",
              "arrange": "lanes",
              "wires": [
                {
                  "verb": "select",
                  "to": "reader"
                }
              ]
            },
            {
              "t": "leaf",
              "kind": "reader",
              "name": "reader"
            }
          ]
        }
      }
    },
    {
      "name": "lastcall",
