        "root": {
          "t": "split",
          "dir": "row",
          "weights": [
            0.5,
            0.5
          ],
          "kids": [
            {
              "t": "leaf",
              "kind": "activity",
              "name": "activity"
            },
            {
              "t": "leaf",
              "kind": "reader",
              "name": "reader"
            }
          ]
        }
      }
    },
    {
      "name": "who",
      "title": "who's online",
      "toolbar": [
        "bar.open",
        "bar.open scope=screens"
      ],
      "layout": {
