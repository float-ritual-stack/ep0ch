{
  "contract": 2,
  "id": "gallery",
  "version": 2,
  "name": "Gallery",
  "description": "Pictures as cards: the notes under a line, each shown by its cover picture.",
  "run": ["bun", "gallery.ts"],
  "handlers": [
    {
      "key": "gallery",
      "kind": "component",
      "effects": "read",
      "staleAfter": "1m",
      "description": "The notes under this block as cards, each with its [cover::] picture",
      "argument": { "name": "size", "required": false, "pattern": "^([1-9]|[1-5][0-9]|60)$", "description": "rows tall, 1 to 60 (default 6)" }
    },
    {
      "key": "pic",
      "kind": "component",
      "effects": "read",
      "staleAfter": "1m",
      "description": "One picture, from a path the outline names",
      "argument": { "name": "path", "required": true, "description": "the picture's path, or file:/path" }
    }
  ]
}
