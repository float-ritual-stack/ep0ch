{
  "contract": 2,
  "id": "runbook",
  "version": 6,
  "name": "Runbook",
  "description": "Run a fence at a time with context and a separate run record.",
  "demo": "demo",
  "run": [
    "bun",
    "runbook.ts"
  ],
  "deadline": "5m",
  "handlers": [
    {
      "key": "run",
      "kind": "component",
      "effects": "read"
    }
  ],
  "actions": [
    {
      "id": "run-step",
      "label": "Run this step",
      "on": "handler:run",
      "key": "x",
      "effects": "write"
    },
    {
      "id": "record",
      "label": "Record a run",
      "on": "block",
      "effects": "write"
    }
  ]
}
