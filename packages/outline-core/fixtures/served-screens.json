  "kinds": [
    {
      "kind": "screens.tree",
      "extension": "screens",
      "name": "Outline",
      "about": "the outline tree; ⏎ opens a note where its opens land",
      "drawer": "list",
      "fields": {
        "from": "children"
      },
      "replaces": [
        "tree"
      ],
      "serves": [
        "tree"
      ]
    },
    {
      "kind": "screens.reader",
      "extension": "screens",
      "name": "Reader",
      "about": "a reader of notes (a detail): it keeps the note opened into it (note=<id> to start on one); mode=pinned pins it, on that note or page=<name>, so every open aimed at it lands beside it",
      "drawer": "page",
      "replaces": [
        "reader"
      ],
      "serves": [
        "reader"
      ]
    },
    {
      "kind": "screens.query",
      "extension": "screens",
      "name": "Query",
      "about": "the cards a saved view lists (view=<the virtual branch's block id>), or a query in the views' grammar (query=\"type=bed\", source=tile:<its home reader>: a tag opened in a reader, PIE-800); a board lane is one",
      "drawer": "list",
      "fields": {
        "from": "query"
      },
      "replaces": [
        "query"
      ],
      "serves": [
        "query"
      ]
    },
    {
      "kind": "screens.backlinks",
      "extension": "screens",
      "name": "Links",
      "about": "the links of a note, its subject, beside its home reader (source=tile:<name>): its outlinks, resources, backlinks and children (linkGroups= names some); subject=held (the default) keeps the subject until b aims it again, subject=follows lists what its home shows as it changes; stages=next,doing,waiting names the stage values its headers and Stage control use, in that order (others are said as other, never hidden)",
      "drawer": "list",
      "fields": {
        "from": "links"
      },
      "replaces": [
        "backlinks"
      ],
      "serves": [
        "backlinks"
      ]
    },
    {
      "kind": "screens.props",
      "extension": "screens",
      "name": "Properties",
      "about": "the properties and the record of the note another tile shows (source=tile:<name>); a pick opens the question for that value",
      "drawer": "list",
      "fields": {
        "from": "properties",
        "subject": "follows"
      },
      "replaces": [
        "props"
      ],
      "serves": [
        "props"
      ]
    },
    {
      "kind": "screens.facets",
      "extension": "screens",
      "name": "Facets",
      "about": "the properties the notes have, each opening to its values with uses and last use: include or exclude values (ORed in a facet, ANDed across them), path values as a tree, the selection as the views' query text, editable and savable as a view (PIE-881); query=<a starting query>; ^W o # opens it on the tags facet (args.open=[tag], no calendar)",
      "drawer": "list",
      "fields": {
        "from": "facets"
      },
      "replaces": [
        "facets"
      ],
      "serves": [
        "facets"
      ]
    },
    {
      "kind": "screens.matches",
      "extension": "screens",
      "name": "Matches",
      "about": "a facets tile's Matches (PIE-1443: the notes its selection leaves, grouped Pinned, Today, Yesterday, Previous 7 days, then months) in a tile of its own beside it (source=tile:<the facets tile>); its select and open wires say where a pick previews and ⏎ opens. Opened by facets.place place=tile (ctrl+o), closed when Matches goes back",
      "drawer": "list",
      "fields": {
        "from": "query",
        "sort": "updated desc"
      },
      "replaces": [
        "matches"
      ],
      "serves": [
        "matches"
      ]
    },
    {
      "kind": "screens.activity",
      "extension": "screens",
      "name": "Activity",
      "about": "recent edits by people and agents",
      "drawer": "list",
      "fields": {
        "from": "activity"
      },
      "replaces": [
        "activity"
      ],
      "serves": [
        "activity"
      ]
    },
    {
      "kind": "screens.who",
      "extension": "screens",
      "name": "Who",
      "about": "who's attached to the outline",
      "drawer": "list",
      "fields": {
        "from": "clients"
      },
      "replaces": [
        "who"
      ],
      "serves": [
        "who"
      ]
    },
    {
      "kind": "screens.extensions",
      "extension": "screens",
      "name": "Extensions",
      "about": "the outline's extensions: the ones installed (a row opens its page), each one's settings, and the ones the repo has that aren't installed (a row installs one); with words typed in its question, removing one too",
      "drawer": "list",
      "fields": {
        "from": "extensions"
      },
      "replaces": [
        "extensions"
      ],
      "serves": [
        "extensions"
      ]
    },
    {
      "kind": "screens.outlines",
      "extension": "screens",
      "name": "Outlines",
      "about": "the outlines there are to open: this machine's and the ones on the machines it holds a forward to; a row switches the window to one",
      "drawer": "list",
      "fields": {
        "from": "outlines"
      },
      "replaces": [
        "outlines"
      ],
      "serves": [
        "outlines"
      ]
    }
