  "kinds": [
    {
      "kind": "screens.tree",
      "extension": "screens",
      "name": "Outline",
      "about": "the outline tree; a pick opens a note where its opens land",
      "drawer": "list",
      "fields": {
        "from": "children"
      },
      "replaces": [
        "tree"
      ]
    },
    {
      "kind": "screens.reader",
      "extension": "screens",
      "name": "Reader",
      "about": "a reader of notes (a detail): it keeps the note opened into it (note=<id> to start on one); mode=pinned pins it, on that note or page=<name>, so every open aimed at it lands beside it",
      "drawer": "page",
      "replaces": [
        "reader"
      ]
    },
    {
      "kind": "screens.query",
      "extension": "screens",
      "name": "Query",
      "about": "the notes a question lists (query=\"type=bed NOT stage=done\", the views' grammar), or the cards of a saved view (view=<its block id>); group=<a property name> with arrange=lanes makes a board's lanes, sort= and columns= name properties too",
      "drawer": "list",
      "fields": {
        "from": "query"
      },
      "replaces": [
        "query"
      ]
    },
    {
      "kind": "screens.backlinks",
      "extension": "screens",
      "name": "Links",
      "about": "the links of a note, its subject, beside its home reader (source=tile:<name>): the notes that link to it, the ones it links to and the ones under it (linkGroups= names some); subject=follows lists what its home shows as it changes",
      "drawer": "list",
      "fields": {
        "from": "links"
      },
      "replaces": [
        "backlinks"
      ]
    },
    {
      "kind": "screens.props",
      "extension": "screens",
      "name": "Properties",
      "about": "the properties and the record of the note another tile shows (source=tile:<name>); a pick opens the question for that value",
      "drawer": "list",
      "fields": {
        "from": "properties",
        "subject": "follows"
      },
      "replaces": [
        "props"
      ]
    },
    {
      "kind": "screens.facets",
      "extension": "screens",
      "name": "Facets",
      "about": "the properties the notes have, each opening to its values with how many notes carry them; a pick narrows the question, and the Matches tile beside it (source=tile:<this one>) lists what is left; query=<a starting query>",
      "drawer": "list",
      "fields": {
        "from": "facets"
      },
      "replaces": [
        "facets"
      ]
    },
    {
      "kind": "screens.matches",
      "extension": "screens",
      "name": "Matches",
      "about": "a facets tile's Matches: the notes its selection leaves, in a tile of its own beside it (source=tile:<the facets tile>); its select and open wires say where a pick previews and opens",
      "drawer": "list",
      "fields": {
        "from": "query",
        "sort": "updated desc"
      },
      "replaces": [
        "matches"
      ]
    },
    {
      "kind": "screens.activity",
      "extension": "screens",
      "name": "Activity",
      "about": "recent edits by people and agents",
      "drawer": "list",
      "fields": {
        "from": "activity"
      },
      "replaces": [
        "activity"
      ]
    },
    {
      "kind": "screens.who",
      "extension": "screens",
      "name": "Who",
      "about": "who's attached to the outline",
      "drawer": "list",
      "fields": {
        "from": "clients"
      },
      "replaces": [
        "who"
      ]
    }
  ],
