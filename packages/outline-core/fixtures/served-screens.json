  "kinds": [
    {
      "kind": "screens.tree",
      "extension": "screens",
      "name": "Outline",
      "about": "the outline as a tree; a pick opens a note where the tile's opens land",
      "drawer": "list",
      "fields": {
        "from": "children"
      },
      "replaces": [
        "tree"
      ],
      "serves": [
        "tree"
      ]
    },
    {
      "kind": "screens.reader",
      "extension": "screens",
      "name": "Reader",
      "about": "a reader of notes: it keeps the note opened into it (note=<id> to start on one); mode=pinned pins it, on that note or page=<name>, so every open aimed at it lands beside it",
      "drawer": "page",
      "replaces": [
        "reader"
      ],
      "serves": [
        "reader"
      ]
    },
    {
      "kind": "screens.query",
      "extension": "screens",
      "name": "Query",
      "about": "the notes a saved view lists (view=<the virtual branch's block id>), or the matches of a question in the views' grammar (query=\"type=bed\"; source=tile:<its home reader> when it was opened from a reader); a board's lane is one",
      "drawer": "list",
      "fields": {
        "from": "query"
      },
      "replaces": [
        "query"
      ],
      "serves": [
        "query"
      ]
    },
    {
      "kind": "screens.backlinks",
      "extension": "screens",
      "name": "Links",
      "about": "the links of a note, its subject, beside its home reader (source=tile:<name>): its outlinks, resources, backlinks and children (linkGroups= names some); subject=held (the default) keeps the subject until it is aimed again, subject=follows lists what its home shows as it changes; stages=next,doing,waiting names the stage values a door that groups them by stage uses, in that order (others are said as other, never hidden)",
      "drawer": "list",
      "fields": {
        "from": "links"
      },
      "replaces": [
        "backlinks"
      ],
      "serves": [
        "backlinks"
      ]
    },
    {
      "kind": "screens.props",
      "extension": "screens",
      "name": "Properties",
      "about": "the properties and the record of the note another tile shows (source=tile:<name>); a pick opens the question for that value",
      "drawer": "list",
      "fields": {
        "from": "properties",
        "subject": "follows"
      },
      "replaces": [
        "props"
      ],
      "serves": [
        "props"
      ]
    },
    {
      "kind": "screens.facets",
      "extension": "screens",
      "name": "Facets",
      "about": "the properties the notes have, each opening to its values with how often and how lately each is used; a value picked narrows the question (values of one property are ORed, properties ANDed), and the selection reads as a query in the views' grammar; query=<a starting query>",
      "drawer": "list",
      "fields": {
        "from": "facets"
      },
      "replaces": [
        "facets"
      ],
      "serves": [
        "facets"
      ]
    },
    {
      "kind": "screens.matches",
      "extension": "screens",
      "name": "Matches",
      "about": "the notes a facets tile's selection leaves (source=tile:<the facets tile>), newest first, in a tile of its own beside it; its select and open wires say where a pick is shown and where it opens",
      "drawer": "list",
      "fields": {
        "from": "query",
        "sort": "updated desc"
      },
      "replaces": [
        "matches"
      ],
      "serves": [
        "matches"
      ]
    },
    {
      "kind": "screens.activity",
      "extension": "screens",
      "name": "Activity",
      "about": "recent edits by people and agents",
      "drawer": "list",
      "fields": {
        "from": "activity"
      },
      "replaces": [
        "activity"
      ],
      "serves": [
        "activity"
      ]
    },
    {
      "kind": "screens.who",
      "extension": "screens",
      "name": "Who",
      "about": "who's attached to the outline",
      "drawer": "list",
      "fields": {
        "from": "clients"
      },
      "replaces": [
        "who"
      ],
      "serves": [
        "who"
      ]
    },
    {
      "kind": "screens.threads",
      "extension": "screens",
      "name": "Comments",
      "about": "the comment threads on the note another tile shows (source=tile:<name>): the ones open first, each with its passage and replies under it, and Reply and Resolve as its own presses",
      "drawer": "list",
      "fields": {
        "from": "threads",
        "subject": "follows"
      },
      "replaces": [
        "threads"
      ],
      "serves": [
        "threads"
      ]
    },
    {
      "kind": "screens.proposals",
      "extension": "screens",
      "name": "Proposals",
      "about": "the edits waiting beside the note another tile shows (source=tile:<name>): who sent each and why it didn't apply, what it would change as lines, and Apply and Dismiss as its own presses",
      "drawer": "list",
      "fields": {
        "from": "proposals",
        "subject": "follows"
      },
      "replaces": [
        "proposals"
      ],
      "serves": [
        "proposals"
      ]
    },
    {
      "kind": "screens.revisions",
      "extension": "screens",
      "name": "Revisions",
      "about": "the texts the note another tile shows had (source=tile:<name>), newest first; a press on an earlier one shows what changed since, and Restore puts its text in the editor",
      "drawer": "list",
      "fields": {
        "from": "revisions",
        "subject": "follows"
      },
      "replaces": [
        "revisions"
      ],
      "serves": [
        "revisions"
      ]
    },
    {
      "kind": "screens.keymap",
      "extension": "screens",
      "name": "Keys",
      "about": "every way to press an action in this door: its keys, the act line they run, where they hold and what they do, read from the actions' own rows; a pick runs the line",
      "drawer": "list",
      "fields": {
        "from": "actions"
      },
      "replaces": [
        "keymap"
      ],
      "serves": [
        "keymap"
      ]
    },
    {
      "kind": "screens.components",
      "extension": "screens",
      "name": "Components",
      "about": "every component there is to write, under its group; a press on one shows what it is, its own example as written and that example drawn",
      "drawer": "list",
      "fields": {
        "from": "components"
      },
      "replaces": [
        "components"
      ],
      "serves": [
        "components"
      ]
    },
    {
      "kind": "screens.extensions",
      "extension": "screens",
      "name": "Extensions",
      "about": "the outline's extensions: the ones installed (a row opens its page), each one's settings, and the ones the repo has that aren't installed (a row installs one); with words typed in its question, removing one too",
      "drawer": "list",
      "fields": {
        "from": "extensions"
      },
      "replaces": [
        "extensions"
      ],
      "serves": [
        "extensions"
      ]
    },
    {
      "kind": "screens.outlines",
      "extension": "screens",
      "name": "Outlines",
      "about": "the outlines there are to open: this machine's and the ones on the machines it holds a forward to; a row switches the window to one",
      "drawer": "list",
      "fields": {
        "from": "outlines"
      },
      "replaces": [
        "outlines"
      ],
      "serves": [
        "outlines"
      ]
    },
    {
      "kind": "screens.programs",
      "extension": "screens",
      "name": "Programs",
      "about": "the programs this door runs in its terminal tiles, and the ones still running that no tile shows: what each is, what keeps it running and where it is; a row takes the keys to its program, in a tile beside the note when it has none",
      "drawer": "list",
      "fields": {
        "from": "programs"
      },
      "replaces": [
        "programs"
      ],
      "serves": [
        "programs"
      ]
    },
    {
      "kind": "terminal.shell",
      "extension": "terminal",
      "name": "Shell",
      "about": "your login shell in a terminal beside your notes: every key goes to it until the key that leaves (the native window draws it when it is built with its terminal: cargo build --features pty)",
      "drawer": "pty"
    },
    {
      "kind": "terminal.agent",
      "extension": "terminal",
      "name": "Agent",
      "about": "an agent in a terminal beside your notes: your shell with the agent's command typed into it (command=<another program> runs that instead; the native window draws it when it is built with its terminal: cargo build --features pty)",
      "drawer": "pty",
      "fields": {
        "command": "claude"
      }
    }
  ],
