#!/usr/bin/env bash
# An agent's own door settings on a shared machine (PIE-597): its state, control socket, outlines folder and
# temp and XDG folders (config, data, state, cache: the backup commands read the person's ~/.config/ep0ch/backup.env
# otherwise), in a private folder of its own, with none of the person's EP0CH_* settings. Wrap a test run or a
# test door in it, never the agent's own session (its outline tools would follow EP0CH_OUTLINES to scratch).
#
#   scripts/agent-env <name> -- <cmd …>          run cmd with the agent's settings
#   scripts/agent-env <name> --test -- <cmd …>   the same, queued for a test slot and capped (CPU, memory)
#   scripts/agent-env <name> --print             the settings, as export lines for a shell
#   scripts/agent-env <name> --clean             remove the agent's folder
#
# The folder is $EP0CH_AGENT_ROOT/<name> (default ~/.agent-env/<name>, mode 700), short enough for sockets; its temp
# folder is $EP0CH_AGENT_TMP/ep0ch-agent-<uid>/<name> (default under /tmp, outside $HOME and its ~/.ep0ch). The
# person's settings are cleared by packages/door/scripts/test-door-env.sh, the same as a test door's.
#
# --test: at most EP0CH_TEST_SLOTS runs at once on this machine (default 2), each in a systemd user scope with
# CPUQuota=EP0CH_TEST_CPU (default 200%) and MemoryMax=EP0CH_TEST_MEM (default 3G). Whatever the run leaves
# behind (a test door's shell, a scratch host) is stopped with its scope when it ends. Every run, --test or not, has
# oom_score_adj 1000: when memory runs out, it goes before the person's outline host and door. Without systemd it is only
# queued (it says so). The exit code is the command's. Full suites belong in a boxd box: scripts/box-test.
# A --test run says what it's doing (waiting for a slot, running, passed or its exit code) to a terminal that speaks the
# Program Status Protocol (OSC 7501: a door's terminal tile, Ghostty); elsewhere nothing. EP0CH_PROGRAM_STATUS=0 stops it.
set -euo pipefail

here=$(cd "$(dirname "$0")/.." && pwd)
usage() { sed -n '6,9p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
[ $# -ge 1 ] || usage
name=$1; shift
case $name in ''|*/*|.*|-*) echo "agent-env: a name is letters, digits, - and _ (got \"$name\")" >&2; exit 2;; esac
root=${EP0CH_AGENT_ROOT:-$HOME/.agent-env}
dir=$root/$name

test=0 mode=run
while [ $# -gt 0 ]; do
  case $1 in
    --test) test=1; shift;;
    --print) mode=print; shift;;
    --clean) mode=clean; shift;;
    --) shift; break;;
    *) break;;
  esac
done

# The temp folder is outside the home folder (EP0CH_AGENT_TMP, default /tmp): a scratch folder under $HOME has the
# person's ~/.ep0ch above it, which "the nearest .ep0ch walking up" finds, so a test's folder that names no outline
# would name theirs (the outliner's outline-host tests failed that way under agent-env).
tmpbase=${EP0CH_AGENT_TMP:-/tmp}/ep0ch-agent-$(id -u)
tmp=$tmpbase/$name
# A folder of ours in a shared /tmp: made here (mode 700) or found as a real folder this user owns, never a symlink
# (one someone else planted would send the chmod, the run's files and --clean somewhere else) and never another's.
private_dir() {
  if [ -L "$1" ]; then echo "agent-env: $1 is a symlink; remove it, or set EP0CH_AGENT_TMP to a folder of your own outside \$HOME" >&2; exit 2; fi
  if [ ! -e "$1" ] && ! mkdir -m 700 "$1" 2>/dev/null && [ ! -d "$1" ]; then echo "agent-env: can't make $1" >&2; exit 2; fi
  if [ -L "$1" ] || [ ! -d "$1" ] || [ ! -O "$1" ]; then echo "agent-env: $1 isn't a folder of yours; set EP0CH_AGENT_TMP to a folder of your own outside \$HOME" >&2; exit 2; fi
  chmod 700 "$1"
}
mkdir -p "${EP0CH_AGENT_TMP:-/tmp}"
private_dir "$tmpbase"
if [ "$mode" = clean ]; then rm -rf -- "$dir" "$tmp"; echo "agent-env: removed $dir and $tmp"; exit 0; fi
private_dir "$tmp"

umask 077
mkdir -p "$root" "$dir/state" "$dir/outlines" "$dir/xdg/config" "$dir/xdg/data" "$dir/xdg/state" "$dir/xdg/cache"
chmod 700 "$root" "$dir"
settings=(EP0CH_STATE="$dir/state" EP0CH_CONTROL="$dir/control.sock" EP0CH_OUTLINES="$dir/outlines" TMPDIR="$tmp" EP0CH_AGENT_ENV="$name"
  # Private XDG folders: the backup commands read ~/.config/ep0ch/backup.env (its repository, mirrors and keys) from
  # $XDG_CONFIG_HOME, the Litestream guard's pause records live in $XDG_STATE_HOME, and a cache or data folder of the
  # person's is theirs. None of them is the real one here.
  XDG_CONFIG_HOME="$dir/xdg/config" XDG_DATA_HOME="$dir/xdg/data" XDG_STATE_HOME="$dir/xdg/state" XDG_CACHE_HOME="$dir/xdg/cache"
  # AWS tools read ~/.aws whatever XDG says: point them at empty files here.
  AWS_SHARED_CREDENTIALS_FILE="$dir/xdg/config/aws-credentials" AWS_CONFIG_FILE="$dir/xdg/config/aws-config")

if [ "$mode" = print ]; then
  for v in $(env | sed -n 's/^\(EP0CH_[A-Za-z0-9_]*\)=.*/\1/p'); do echo "unset $v"; done
  echo "unset EP0CH_DAILY_AGENT EP0CH_DAILY_CWD EP0CH_LANDING EP0CH_NOW_PAGE"
  for v in $(env | sed -n 's/^\(\(RESTIC\|LITESTREAM\|AWS\)_[A-Za-z0-9_]*\)=.*/\1/p'); do echo "unset $v"; done
  for s in "${settings[@]}" EP0CH_DAILY_AGENT=sh EP0CH_DAEMON=0; do printf 'export %s=%q\n' "${s%%=*}" "${s#*=}"; done
  exit 0
fi
[ $# -ge 1 ] || usage

# Everything run here is the first thing the kernel kills when the machine runs out of memory, never the outline host:
# oom_score_adj 1000, inherited by all it starts. Raising it needs no privilege (a user unit can't lower the host's,
# and a scope takes no OOMScoreAdjust); a system without /proc goes on without it.
run=(sh -c 'echo 1000 > /proc/self/oom_score_adj 2>/dev/null; exec "$@"' agent-env "$here/packages/door/scripts/test-door-env.sh" "${settings[@]}" "$@")
[ "$test" = 1 ] || exec "${run[@]}"

# What the run is doing, to a terminal that speaks the Program Status Protocol (OSC 7501: the door's tiles, Ghostty):
# asked once, then each report goes without asking (packages/outliner/scripts/program-status.ts).
ps_on=0
bun "$here/packages/outliner/scripts/program-status.ts" --probe 2>/dev/null && ps_on=1
status() { [ $ps_on = 1 ] && EP0CH_PROGRAM_STATUS=1 bun "$here/packages/outliner/scripts/program-status.ts" "$@" --app agent-env 2>/dev/null; return 0; }
what="$name: $(printf '%s ' "$@" | cut -c1-120)"
finished() { if [ "$1" = 0 ]; then status done "$what passed"; else status error "$what: exit $1"; fi; }

# A test slot: the first free one of EP0CH_TEST_SLOTS, held (an open, locked file) until the run ends.
slots=${EP0CH_TEST_SLOTS:-2}
mkdir -p "$root/.slots"
said=0
while :; do
  for i in $(seq 1 "$slots"); do
    exec {slot}>"$root/.slots/$i"
    if flock -n "$slot"; then echo "$name $$ $(date -u +%FT%TZ)" > "$root/.slots/$i.who"; break 2; fi
    exec {slot}>&-
  done
  if [ $said = 0 ]; then
    echo "agent-env: $slots test runs already going ($(cat "$root"/.slots/*.who 2>/dev/null | cut -d' ' -f1 | paste -sd, -)); waiting for one to end" >&2
    status working "$name waits for a test slot"
    said=1
  fi
  sleep 5
done

status working "$what"
if command -v systemd-run >/dev/null && systemctl --user is-system-running >/dev/null 2>&1; then
  unit="agent-env-$name-$$"
  set +e
  # Ended itself (a signal to this wrapper): the run and whatever it started go with the scope.
  trap 'systemctl --user stop "$unit.scope" >/dev/null 2>&1; status idle "$name: stopped"; exit 143' TERM INT HUP
  systemd-run --user --scope --quiet --collect --unit="$unit" -p CPUQuota="${EP0CH_TEST_CPU:-200%}" -p MemoryMax="${EP0CH_TEST_MEM:-3G}" -- "${run[@]}" <&0 &   # <&0: a background job would otherwise read /dev/null
  wait $!
  code=$?
  # Anything the run started and left (a door's shell, a scratch host) goes with its scope.
  systemctl --user stop "$unit.scope" >/dev/null 2>&1
  finished $code
  exit $code
fi
echo "agent-env: no systemd user manager here, so the run is queued but not capped" >&2
set +e
"${run[@]}"
code=$?
finished $code
exit $code
