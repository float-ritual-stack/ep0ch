#!/usr/bin/env bash
# The nightly whole-suite run on main that CONTRIBUTING.md ("Verification") and AGENTS.md ("One test gate") describe:
# origin/main's head through scripts/box-test on float-box, every package, each door file alone too. Run by the
# float-box user timer ep0ch-nightly.timer (04:00, after the 03:00 syncs and the 03:30 backup); by hand it is the same.
# With --alone: it waits for the box-test runs ahead and later ones wait for it (focused runs and builders still go beside
# it). Its limits are wall-clock time, and on Nov 6 a merge batch beside it slowed every file by 1.3 to 2.1 times (PIE-1600).
#
#   scripts/nightly-main            test origin/main's head; green: a row in nightly.tsv; red: one ticket listing the red files
#
# The test-time budget (PIE-1422, scripts/test-budget.ts against scripts/test-budget.json at main): over it, the night
# is red and one ticket, "Over test budget: investigate", carries the files that grew since the last green night; at 80%
# of a package's total, a warning line goes under the day's build log; so does an over-budget night while the budget
# still says `"estimated": true` (never measured): a warning and the measured budget, not a red night. A green night within budget keeps its times as
# the next night's comparison (last-green.tsv beside nightly.tsv). The row's seventh column is the budget's verdict.
#
# Red on main is a ticket, never a rerun (AGENTS.md). The ticket goes to pie's queue, high, as loki, with the log's path
# and each red file once. Nov 2: the run the docs promised wasn't scheduled anywhere, and 13 merges on Oct 31 left main
# red for 34 hours before anyone saw it.
set -uo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
dir=${XDG_STATE_HOME:-$HOME/.local/state}/ep0ch/nightly
mkdir -p "$dir"
git -C "$repo" fetch -q origin main || { echo "nightly-main: git fetch failed" >&2; exit 1; }
sha=$(git -C "$repo" rev-parse origin/main)
day=$(date +%F)
log=$dir/$day-${sha:0:9}.log
start=$(date +%s)
EP0CH_PROGRAM_STATUS=0 "$repo/scripts/box-test" --on float-box --alone --ref "$sha" --each all >"$log" 2>&1
code=$?
secs=$(( $(date +%s) - start ))
# The files that failed: the file header bun prints before a run of tests, kept when a (fail) line follows it.
# bun's summary at a suite's end repeats each (fail) under no file: it would be pinned on whichever file ran last.
red=$(awk '/\.test\.ts:$/{f=$0; sub(/:$/, "", f)} /^[0-9]+ tests? failed:$/{f=""} /^\(fail\)/{if (f != "") print f}' "$log" | sort -u)
count=$(printf '%s' "$red" | grep -c . || true)

# The budget: the comparison box-test printed at the end of the log, decided here (0 within, 3 near, 4 over, 5 none).
md=$(mktemp) line=$(mktemp)
bun "$repo/scripts/test-budget.ts" compare --log "$log" --budget-at "$sha" --last "$dir/last-green.tsv" --markdown "$md" --line "$line" >/dev/null
budget=$?
case $budget in 0) verdict=ok;; 3) verdict=near;; 4) verdict=over;; *) verdict=none;; esac
# Over a budget still marked estimated (never measured): a warning like near, never red; its line says so.
[ "$verdict" = ok ] && grep -q '^over the estimated' "$line" && verdict=estimated
# A green night within budget is the next one's "since the last green night".
if [ "$code" = 0 ] && [ "$verdict" != over ] && grep -q "^test-time	" "$log"; then
  { echo "# $day ${sha:0:12}"; grep "^test-time	" "$log"; } > "$dir/last-green.tsv.new" && mv "$dir/last-green.tsv.new" "$dir/last-green.tsv"
fi
final=$code
[ "$final" = 0 ] && [ "$verdict" = over ] && final=4
printf '%s\t%s\t%s\t%ss\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "${sha:0:12}" "$final" "$secs" "$count" "$log" "$verdict" >> "$dir/nightly.tsv"

cli() { EP0CH_WS=pie EP0CH_MACHINE=float-2 bun "$repo/packages/outliner/src/cli.ts" "$@"; }
if [ "$verdict" = near ] || [ "$verdict" = estimated ]; then
  # Under the day's build log (yesterday's when today's isn't written yet at 04:00).
  under=
  for d in "$day" "$(date -d yesterday +%F)"; do
    under=$(cli list --query "type=build-log AND day=$d" --fields id --limit 1 2>/dev/null | jq -r '.blocks[0].id // empty')
    [ -n "$under" ] && break
  done
  if [ -n "$under" ]; then
    cli create --parent "$under" --text "Nightly $day (main \`${sha:0:12}\`): $(cat "$line"). The log: \`$log\` on float-box. [type::test-budget]" \
      --author agent --actor loki >/dev/null || echo "nightly-main: the build log's warning line failed: $(cat "$line")" >&2
  else echo "nightly-main: no build log for $day or the day before to warn in: $(cat "$line")" >&2; fi
fi
if [ "$verdict" = over ]; then
  body=$(mktemp)
  {
    echo "Evan opens the nightly result and sees over test budget: investigate, with the files that grew since the last green night, before the suite creeps back to 60 minutes."
    echo
    echo "- **The run:** main \`${sha:0:12}\`, $day, $((secs / 60)) min of wall time on float-box; $(cat "$line")."
    echo "- **The budget:** \`scripts/test-budget.json\` at main; only Evan raises it."
    echo
    cat "$md"
  } >"$body"
  cli work create --title "Over test budget on $day: investigate" \
    --project pi-outliner --arc floor --track tests --priority high --stage queued --new \
    --body-file "$body" --author agent --actor loki >/dev/null || echo "nightly-main: filing the over-budget request failed; the log is $log" >&2
  rm -f "$body"
fi
rm -f "$md" "$line"
[ "$code" = 0 ] && exit "$final"

body=$(mktemp)
{
  echo "Evan opens pie in the morning and main's red is already a ticket, with every red file named, not something found by hand days later."
  echo
  echo "## The run (scripts/nightly-main, $day)"
  echo "- **main:** \`${sha:0:12}\`, box-test exit $code after $((secs / 60)) min, \`--each all\` on float-box."
  echo "- **Log:** \`$log\` on float-box."
  echo
  echo "## Red files ($count)"
  if [ "$count" -gt 0 ]; then printf '%s\n' "$red" | sed 's/^/- `/; s/$/`/'; else echo "- none named: the run failed before a test file reported (read the log's last lines)"; fi
  echo
  echo "## Done when"
  echo "- Each file above passes alone on main, fixed at its cause (the merge that changed it, by bisect), red first."
  echo "- The next night's run is green."
} >"$body"
cli work create \
  --title "Main is red on $day: $count files fail in the nightly run" \
  --project pi-outliner --arc floor --track tests --priority high --stage queued --new \
  --body-file "$body" --author agent --actor loki >/dev/null || echo "nightly-main: filing the ticket failed; the log is $log" >&2
rm -f "$body"
exit "$code"
